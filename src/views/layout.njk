<!DOCTYPE html>
<html lang="en" class="h-full">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>
        {% block title %}Slack Channel Panel{% endblock %}
    </title>

    <link rel="icon" type="image/png" href="/logo.png">
    <link rel="stylesheet" href="/styles.css">

</head>

<body class="flex min-h-full flex-col bg-gray-50 text-gray-900 antialiased">

    <header class="border-b border-gray-200 bg-white">
        <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4">
            <h1 class="text-xl font-semibold">
                <a href="/" class="flex items-center gap-3 hover:text-gray-600">
                    {# Decorative: the name next to it says what it is. #}
                    <img src="/logo.png" alt="" width="138" height="160" class="h-10 w-auto">
                    Slack Channel Panel
                </a>
            </h1>
            {% if user %}
            <form method="post" action="/auth/logout">
                <button class="cursor-pointer rounded-md border border-gray-300 bg-white px-3 py-1.5 text-sm font-medium hover:bg-gray-100 focus:outline-2 focus:outline-offset-2 focus:outline-gray-900">
                    Sign out
                </button>
            </form>
            {% endif %}
        </div>
    </header>

    <main class="mx-auto w-full max-w-6xl flex-1 px-4 py-8">
        {% block content %}{% endblock %}
    </main>

    <footer class="border-t border-gray-200 bg-white">
        <div class="mx-auto max-w-6xl px-4 py-4 text-sm text-gray-500">
            <p>Slack Channel Panel</p>
        </div>
    </footer>

</body>
</html>
