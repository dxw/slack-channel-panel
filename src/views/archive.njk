{% extends "layout.njk" %}

{% block title %}{{ 'Archive #' + channel.name if channel else 'Channel not found' }} – Slack Channel Panel{% endblock %}

{% from "macros/archive.njk" import archiveReason, archiveEffects %}

{% block content %}
    {% set linkClass = 'rounded-md border border-gray-300 bg-white px-3 py-1.5 text-sm font-medium hover:bg-gray-100 focus:outline-2 focus:outline-offset-2 focus:outline-gray-900' %}
    {% if channel %}
        <div class="max-w-xl rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
            <h2 class="text-lg font-semibold">Archive #{{ channel.name }}?</h2>
            <p class="mt-2 text-sm text-gray-600">{{ archiveReason(channel) }}</p>
            <p class="mt-2 text-sm text-gray-600">{{ archiveEffects() }}</p>
            <div class="mt-6 flex items-center gap-3">
                <form method="post" action="/channels/{{ channel.id }}/archive">
                    <button class="cursor-pointer rounded-md bg-red-700 px-3 py-1.5 text-sm font-medium text-white hover:bg-red-800 focus:outline-2 focus:outline-offset-2 focus:outline-gray-900">
                        Archive channel
                    </button>
                </form>
                <a href="/" class="{{ linkClass }}">Cancel</a>
            </div>
        </div>
    {% else %}
        <h2 class="text-lg font-semibold">Channel not found</h2>
        <p class="mt-2 text-sm text-gray-600">This channel doesn't exist, or can't be archived from the dashboard.</p>
        <p class="mt-4"><a href="/" class="{{ linkClass }}">Back to channels</a></p>
    {% endif %}
{% endblock %}
