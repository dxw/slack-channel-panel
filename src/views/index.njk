{% extends "layout.njk" %}

{% block title %}Slack Channel Panel{% endblock %}

{% block content %}

    {# A table heading that sorts by its column when clicked. `link` is from
       the route's `sortLinks`: the URL to go to, and the current direction if
       the table is sorted by this column. #}
    {% macro sortHeader(label, link, classes) %}
        <th scope="col" class="{{ classes }}"
            {% if link.current %}aria-sort="{{ 'ascending' if link.current == 'asc' else 'descending' }}"{% endif %}>
            <a href="{{ link.url }}" class="inline-flex items-center gap-1 rounded hover:text-gray-900 focus:outline-2 focus:outline-offset-2 focus:outline-gray-900 {{ 'text-gray-900' if link.current }}">
                {{ label }}
                {# The same chevron icon in every state, so they all match:
                   up = ascending, down = descending, both = not sorted. #}
                <svg aria-hidden="true" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
                    class="size-4 shrink-0 {{ 'text-gray-900' if link.current else 'text-gray-400' }}">
                    {% if link.current != 'desc' %}<path d="M5 6.5 8 3.5l3 3"/>{% endif %}
                    {% if link.current != 'asc' %}<path d="M5 9.5 8 12.5l3-3"/>{% endif %}
                </svg>
            </a>
        </th>
    {% endmacro %}

    {% if error %}
        <div class="rounded-md border border-red-200 bg-red-50 p-4 text-sm text-red-800" role="alert">
            {{ error }}
        </div>
    {% else %}
        {% if notice %}
            {% if notice.type == 'success' %}
                <div class="mb-4 rounded-md border border-green-200 bg-green-50 p-4 text-sm text-green-800" role="status">{{ notice.text }}</div>
            {% else %}
                <div class="mb-4 rounded-md border border-red-200 bg-red-50 p-4 text-sm text-red-800" role="alert">{{ notice.text }}</div>
            {% endif %}
        {% endif %}
        {% if refreshing %}
            <div class="mb-4 rounded-md border border-blue-200 bg-blue-50 p-4 text-sm text-blue-800" role="status">
                Checking channel activity… {{ progress.done }} of {{ progress.total }}
            </div>
        {% endif %}

        <div class="flex flex-wrap items-end justify-between gap-2 border-b border-gray-200">
            <nav aria-label="Channel status" class="-mb-px flex gap-4">
                {% for tab in [
                    {status: 'active', label: 'Active', href: '/'},
                    {status: 'archived', label: 'Archived', href: '/?status=archived'}
                ] %}
                    {% set current = tab.status == status %}
                    <a href="{{ tab.href }}"
                        {% if current %}aria-current="page"{% endif %}
                        class="border-b-2 px-1 pb-3 text-sm font-medium {{ 'border-gray-900 text-gray-900' if current else 'border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700' }}">
                        {{ tab.label }}
                        <span class="ml-1 rounded-full bg-gray-100 px-2 py-0.5 text-xs text-gray-600">{{ counts[tab.status] }}</span>
                    </a>
                {% endfor %}
            </nav>
            {% if refreshedAt %}
                <p class="pb-3 text-sm text-gray-500">Last updated {{ refreshedAt.toLocaleString('en-GB', {dateStyle: 'short', timeStyle: 'short', timeZone: 'Europe/London'}) }}</p>
            {% endif %}
        </div>

        <div class="mt-4 overflow-hidden rounded-lg border border-gray-200 bg-white shadow-sm">
            {# Fixed column widths (set on the header cells), so the columns stay
               the same size whatever is on the page. Description takes the space
               left over. Less important columns are hidden on smaller screens,
               so the table never scrolls sideways. #}
            {% set archivedTab = status == 'archived' %}
            <table class="w-full table-fixed divide-y divide-gray-200 text-sm">
                <thead class="bg-gray-50 text-left font-medium text-gray-600">
                    <tr>
                        {# Name is wider on the Archived tab, which has fewer columns.
                           Description takes whatever space is left. #}
                        {{ sortHeader('Name', sortLinks.name, 'px-2 py-3 sm:px-4 ' + ('w-[50%] sm:w-[40%] lg:w-80' if archivedTab else 'w-[40%] sm:w-[30%] lg:w-56')) }}
                        {% if not archivedTab %}
                            {{ sortHeader('Members', sortLinks.members, 'hidden w-24 px-2 py-3 text-right sm:px-4 md:table-cell') }}
                        {% endif %}
                        <th scope="col" class="hidden px-2 py-3 sm:table-cell sm:px-4">Description</th>
                        {% if archivedTab %}
                            {{ sortHeader('Archived', sortLinks.archived, 'w-28 px-2 py-3 sm:px-4') }}
                        {% else %}
                            {# Hidden on phones to leave room for the Archive button. #}
                            {{ sortHeader('Last message', sortLinks.lastMessage, 'hidden w-32 px-2 py-3 sm:table-cell sm:px-4') }}
                            {{ sortHeader('Messages (30 days)', sortLinks.messages, 'hidden w-32 px-2 py-3 text-right sm:px-4 md:table-cell') }}
                        {% endif %}
                        {% if not archivedTab %}
                            {{ sortHeader('Status', sortLinks.status, 'w-28 px-2 py-3 sm:px-4') }}
                            <th scope="col" class="w-28 px-2 py-3 sm:px-4"><span class="sr-only">Actions</span></th>
                        {% endif %}
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200">
                    {% for channel in channels %}
                        <tr>
                            <td class="px-2 py-3 font-medium sm:px-4">
                                {# Long names are cut off with "…"; hover to see the full name. #}
                                <div class="flex items-center gap-1.5">
                                    <span class="truncate" title="#{{ channel.name }}">#{{ channel.name }}</span>
                                    {% if channel.isExternal %}
                                        {# Slack Connect channel. The badge doesn't shrink, so long names are cut off before it. #}
                                        <span class="shrink-0 rounded border border-purple-200 bg-purple-50 px-1 text-[10px] leading-4 font-medium text-purple-700 uppercase"
                                            title="Slack Connect: shared with another organisation">Ext</span>
                                    {% endif %}
                                </div>
                            </td>
                            {% if not archivedTab %}
                                <td class="hidden px-2 py-3 text-right tabular-nums sm:px-4 md:table-cell">{{ channel.memberCount }}</td>
                            {% endif %}
                            <td class="hidden px-2 py-3 text-gray-600 sm:table-cell sm:px-4">
                                {# Wraps onto at most 2 lines, then "…"; hover to see it all. #}
                                <div class="line-clamp-2 break-words" title="{{ channel.purpose }}">{{ channel.purpose }}</div>
                            </td>
                            {% if archivedTab %}
                                <td class="px-2 py-3 whitespace-nowrap text-gray-600 sm:px-4">
                                    {% if channel.archivedAt %}
                                        {{ channel.archivedAt.toLocaleDateString('en-GB', {timeZone: 'Europe/London'}) }}
                                    {% else %}
                                        —
                                    {% endif %}
                                </td>
                            {% else %}
                                <td class="hidden px-2 py-3 whitespace-nowrap text-gray-600 sm:table-cell sm:px-4">
                                    {% if not channel.activity %}
                                        —
                                    {% elif channel.activity.lastMessageAt %}
                                        {{ channel.activity.lastMessageAt.toLocaleDateString('en-GB', {timeZone: 'Europe/London'}) }}
                                    {% else %}
                                        No messages
                                    {% endif %}
                                </td>
                                <td class="hidden px-2 py-3 text-right tabular-nums sm:px-4 md:table-cell">
                                    {% if not channel.activity %}
                                        —
                                    {% elif channel.activity.messagesLastMonth >= 100 %}
                                        100+
                                    {% else %}
                                        {{ channel.activity.messagesLastMonth }}
                                    {% endif %}
                                </td>
                            {% endif %}
                            {% if not archivedTab %}
                            <td class="px-2 py-3 whitespace-nowrap sm:px-4">
                                {% if channel.inactive %}
                                    <span class="rounded-full bg-amber-100 px-2 py-0.5 text-xs text-amber-800">Inactive</span>
                                {% elif channel.activity %}
                                    <span class="rounded-full bg-green-100 px-2 py-0.5 text-xs text-green-800">Active</span>
                                {% elif not channel.isMember %}
                                    {# The bot can only read channels it's in, so their activity is unknown. #}
                                    <span class="rounded-full bg-gray-100 px-2 py-0.5 text-xs text-gray-700"
                                        title="The bot isn't in this channel, so it can't see the messages">Unknown</span>
                                {% else %}
                                    <span class="text-xs text-gray-500">Not checked yet</span>
                                {% endif %}
                            </td>
                            <td class="px-2 py-3 text-right sm:px-4">
                                {# Only for quiet channels that are ours to archive. Goes to a confirmation page first. #}
                                {% if channel.canArchive %}
                                    <a href="/channels/{{ channel.id }}/archive"
                                        class="inline-block rounded-md border border-red-300 bg-white px-3 py-1.5 text-sm font-medium text-red-700 hover:bg-red-50 focus:outline-2 focus:outline-offset-2 focus:outline-gray-900">Archive<span class="sr-only"> #{{ channel.name }}</span></a>
                                {% endif %}
                            </td>
                            {% endif %}
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="{{ 3 if archivedTab else 7 }}" class="px-4 py-6 text-center text-gray-500">No {{ status }} channels.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        {% if pagination.total > 0 %}
            {% set linkClass = 'rounded-md border border-gray-300 bg-white px-3 py-1.5 font-medium hover:bg-gray-100 focus:outline-2 focus:outline-offset-2 focus:outline-gray-900' %}
            {% set disabledClass = 'rounded-md border border-gray-200 px-3 py-1.5 font-medium text-gray-400' %}
            <nav aria-label="Pagination" class="mt-4 flex flex-wrap items-center justify-between gap-2 text-sm">
                <p class="text-gray-600">
                    Showing {{ pagination.from }}–{{ pagination.to }} of {{ pagination.total }} channels
                </p>
                <div class="flex items-center gap-2">
                    {% if pagination.previousUrl %}
                        <a href="{{ pagination.previousUrl }}" rel="prev" class="{{ linkClass }}">Previous</a>
                    {% else %}
                        <span class="{{ disabledClass }}" aria-disabled="true">Previous</span>
                    {% endif %}
                    <span class="px-2 text-gray-600">Page {{ pagination.page }} of {{ pagination.totalPages }}</span>
                    {% if pagination.nextUrl %}
                        <a href="{{ pagination.nextUrl }}" rel="next" class="{{ linkClass }}">Next</a>
                    {% else %}
                        <span class="{{ disabledClass }}" aria-disabled="true">Next</span>
                    {% endif %}
                </div>
            </nav>
        {% endif %}
    {% endif %}

{% endblock %}
