{% extends "layout.njk" %}

{% block title %}Slack Channel Panel{% endblock %}

{% block content %}

    {# A table heading that sorts by its column when clicked. `link` is from
       the route's `sortLinks`: the URL to go to, and the current direction if
       the table is sorted by this column. #}
    {% macro sortHeader(label, link, classes) %}
        <th scope="col" class="{{ classes }}"
            {% if link.current %}aria-sort="{{ 'ascending' if link.current == 'asc' else 'descending' }}"{% endif %}>
            <a href="{{ link.url }}" class="inline-flex items-center gap-1 rounded hover:text-gray-900 focus:outline-2 focus:outline-offset-2 focus:outline-gray-900 {{ 'text-gray-900' if link.current }}">
                {{ label }}
                {# The same chevron icon in every state, so they all match:
                   up = ascending, down = descending, both = not sorted. #}
                <svg aria-hidden="true" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
                    class="size-4 shrink-0 {{ 'text-gray-900' if link.current else 'text-gray-400' }}">
                    {% if link.current != 'desc' %}<path d="M5 6.5 8 3.5l3 3"/>{% endif %}
                    {% if link.current != 'asc' %}<path d="M5 9.5 8 12.5l3-3"/>{% endif %}
                </svg>
            </a>
        </th>
    {% endmacro %}

    {# The channel's name, linking to it in Slack. Used on both tabs. #}
    {% macro nameCell(channel) %}
        <td class="px-2 py-3 font-medium sm:px-4">
            <div class="flex items-center gap-1.5">
                <a href="{{ channel.slackUrl }}" target="_blank" rel="noopener"
                    class="truncate underline decoration-gray-300 underline-offset-2 hover:decoration-gray-900 focus:outline-2 focus:outline-offset-2 focus:outline-gray-900"
                    title="Open #{{ channel.name }} in Slack">#{{ channel.name }}<span class="sr-only"> (opens in Slack)</span></a>
                {% if channel.isExternal %}
                    {# Slack Connect channel. The badge doesn't shrink, so long names are cut off before it. #}
                    <span class="shrink-0 rounded border border-purple-200 bg-purple-50 px-1 text-[10px] leading-4 font-medium text-purple-700 uppercase"
                        title="Slack Connect: shared with another organisation">Ext</span>
                {% endif %}
            </div>
        </td>
    {% endmacro %}

    {# The channel's purpose. Wraps onto at most 2 lines, then "…"; hover to
       see it all. Used on both tabs. #}
    {% macro descriptionCell(channel) %}
        <td class="hidden px-2 py-3 text-gray-600 sm:px-4 lg:table-cell">
            <div class="line-clamp-2 break-words" title="{{ channel.purpose }}">{{ channel.purpose }}</div>
        </td>
    {% endmacro %}

    {# A spinning circle, for things happening in the background. #}
    {% macro spinner() %}
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" class="size-5 shrink-0 animate-spin motion-reduce:animate-none">
            <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3" class="opacity-25"/>
            <path d="M22 12a10 10 0 0 0-10-10" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
        </svg>
    {% endmacro %}

    {# Why the dashboard offers to archive a channel. #}
    {% macro archiveReason(channel) -%}
        {%- if channel.inactive -%}
            Nobody has posted in this channel in the last 30 days.
        {%- else -%}
            This channel has fewer than 2 members.
        {%- endif -%}
    {%- endmacro %}

    {% if error %}
        <div class="rounded-md border border-red-200 bg-red-50 p-4 text-sm text-red-800" role="alert">
            {{ error }}
        </div>
    {% else %}
        {% if notice %}
            {% if notice.type == 'success' %}
                <div class="mb-4 rounded-md border border-green-200 bg-green-50 p-4 text-sm text-green-800" role="status">{{ notice.text }}</div>
            {% else %}
                <div class="mb-4 rounded-md border border-red-200 bg-red-50 p-4 text-sm text-red-800" role="alert">{{ notice.text }}</div>
            {% endif %}
        {% endif %}
        <div id="refresh-banner">
        {% if refreshing %}
            <div class="mb-4 flex items-center gap-3 rounded-md border border-blue-200 bg-blue-50 p-4 text-sm text-blue-800" role="status">
                {{ spinner() }}
                <span>Data is refreshing. Please check back in a few minutes.</span>
            </div>
        {% endif %}
        {# Everyone sees that a bulk archive is running. #}
        {% if bulkArchiving %}
            <div class="mb-4 flex items-center gap-3 rounded-md border border-blue-200 bg-blue-50 p-4 text-sm text-blue-800" role="status">
                {{ spinner() }}
                <span>Archiving {{ bulkArchiving.total }} {{ 'channel' if bulkArchiving.total == 1 else 'channels' }}: {{ bulkArchiving.done }} done so far. Reload the page to check progress.</span>
            </div>
        {% endif %}
        {# How a bulk archive went, shown once to the person who started it. #}
        {% if bulkArchiveSummary %}
            {% set summary = bulkArchiveSummary %}
            {% set allArchived = not (summary.skipped | length) and not (summary.failed | length) %}
            <div class="mb-4 space-y-1 rounded-md border p-4 text-sm {{ 'border-green-200 bg-green-50 text-green-800' if allArchived else 'border-amber-200 bg-amber-50 text-amber-900' }}" role="status">
                <p>Archived {{ summary.archived | length }} {{ 'channel' if (summary.archived | length) == 1 else 'channels' }}.</p>
                {% if summary.skipped | length %}
                    <p>Not archived, as they no longer qualify (for example, they’ve had new messages or members): #{{ summary.skipped | join(', #') }}.</p>
                {% endif %}
                {% if summary.failed | length %}
                    <p>Couldn’t archive, so try again or archive them in Slack: #{{ summary.failed | join(', #') }}.</p>
                {% endif %}
            </div>
        {% endif %}
        </div>

        <div class="flex flex-wrap items-end justify-between gap-2 border-b border-gray-200">
            {# Has an ID so search.js can update the counts as you search. #}
            <nav id="channel-tabs" aria-label="Channel status" class="-mb-px flex gap-4">
                {% for tab in [
                    {status: 'active', label: 'Active', href: tabUrls.active},
                    {status: 'archived', label: 'Archived', href: tabUrls.archived}
                ] %}
                    {% set current = tab.status == status %}
                    <a href="{{ tab.href }}"
                        {% if current %}aria-current="page"{% endif %}
                        class="border-b-2 px-1 pb-3 text-sm font-medium {{ 'border-gray-900 text-gray-900' if current else 'border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700' }}">
                        {{ tab.label }}
                        <span class="ml-1 rounded-full bg-gray-100 px-2 py-0.5 text-xs text-gray-600">{{ counts[tab.status] }}</span>
                    </a>
                {% endfor %}
            </nav>
            {# Always on the page, even when empty, so search.js can update it. #}
            <p id="last-updated" class="pb-3 text-sm text-gray-500">
                {%- if refreshedAt -%}
                    Last updated {{ refreshedAt.toLocaleString('en-GB', {dateStyle: 'short', timeStyle: 'short', timeZone: 'Europe/London'}) }}
                {%- endif -%}
            </p>
        </div>

        {# Searches channel names. Works by pressing Enter; with JavaScript
           (search.js), the results also update as you type. Keeps the tab and
           sort, and goes back to page 1. #}
        <form method="get" action="/" role="search" class="mt-4" data-channel-search>
            {% if status == 'archived' %}
                <input type="hidden" name="status" value="archived">
            {% endif %}
            {% if sort != 'name' or dir != 'asc' %}
                <input type="hidden" name="sort" value="{{ sort }}">
                <input type="hidden" name="dir" value="{{ dir }}">
            {% endif %}
            <label for="channel-search" class="sr-only">Search channel names</label>
            <div class="relative w-full sm:max-w-sm">
                <svg aria-hidden="true" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
                    class="pointer-events-none absolute top-1/2 left-3 size-4 -translate-y-1/2 text-gray-400">
                    <circle cx="8.5" cy="8.5" r="5.5"/>
                    <path d="m13 13 4 4"/>
                </svg>
                <input id="channel-search" type="search" name="q" value="{{ q }}"
                    placeholder="Search channels" autocomplete="off" spellcheck="false"
                    class="w-full rounded-md border border-gray-300 bg-white py-2 pr-3 pl-9 text-sm placeholder:text-gray-400 focus:border-gray-900 focus:outline-2 focus:outline-offset-0 focus:outline-gray-900">
            </div>
        </form>
        {# Tells screen reader users how many channels match, after search.js
           updates the results. Outside the results, so it stays on the page. #}
        <p id="search-status" class="sr-only" aria-live="polite"></p>

        {# Archives the ticked channels together. The checkboxes are in the
           table, linked to this form by their `form` attribute. bulk-archive.js
           shows this once a channel is ticked, and asks to confirm first.
           Outside the results, as search.js replaces those. #}
        <form id="bulk-archive-form" method="post" action="/channels/archive" hidden
            class="mt-4 flex items-center justify-between gap-3 rounded-md border border-gray-200 bg-white px-4 py-2 text-sm shadow-sm">
            <p><span data-bulk-count></span> selected</p>
            <button type="button" data-bulk-open
                class="cursor-pointer rounded-md border border-red-300 bg-white px-3 py-1.5 text-sm font-medium text-red-700 hover:bg-red-50 focus:outline-2 focus:outline-offset-2 focus:outline-gray-900">Archive selected</button>
        </form>

        {# Everything search.js replaces when the results change. #}
        <div id="channel-results">
        {% if q %}
            <p id="search-summary" class="sr-only">{{ pagination.total }} {{ 'channel' if pagination.total == 1 else 'channels' }} found</p>
        {% endif %}
        <div class="mt-4 overflow-hidden rounded-lg border border-gray-200 bg-white shadow-sm">
            {# Fixed column widths (set on the header cells), so the columns stay
               the same size whatever is on the page. Description takes the space
               left over. Less important columns are hidden on smaller screens,
               so the table never scrolls sideways. #}
            {% set archivedTab = status == 'archived' %}
            <table class="w-full table-fixed divide-y divide-gray-200 text-sm">
                <thead class="bg-gray-50 text-left font-medium text-gray-600">
                    <tr>
                        {# Name is wider on the Archived tab, which has fewer columns. #}
                        {% if archivedTab %}
                            {{ sortHeader('Name', sortLinks.name, 'w-[50%] px-2 py-3 sm:w-[40%] sm:px-4 lg:w-80') }}
                            <th scope="col" class="hidden px-2 py-3 sm:px-4 lg:table-cell">Description</th>
                            {{ sortHeader('Archived', sortLinks.archived, 'w-28 px-2 py-3 sm:px-4') }}
                        {% else %}
                            {# Ticks every channel on this page that can be archived
                               (bulk-archive.js). Hidden on phones, where there's no room. #}
                            <th scope="col" class="hidden w-10 py-3 pr-0 pl-2 sm:table-cell sm:pl-4">
                                <input type="checkbox" data-select-all
                                    aria-label="Select all channels on this page that can be archived"
                                    {% if not (channels | selectattr('canArchive') | length) %}disabled{% endif %}
                                    class="size-4 cursor-pointer accent-gray-900 disabled:cursor-default">
                            </th>
                            {{ sortHeader('Name', sortLinks.name, 'w-[40%] px-2 py-3 sm:w-[30%] sm:px-4 lg:w-56') }}
                            {{ sortHeader('Members', sortLinks.members, 'hidden w-24 px-2 py-3 text-right sm:px-4 md:table-cell') }}
                            <th scope="col" class="hidden px-2 py-3 sm:px-4 lg:table-cell">Description</th>
                            {{ sortHeader('Shared with', sortLinks.sharedWith, 'hidden w-36 px-2 py-3 sm:px-4 xl:table-cell') }}
                            {# Hidden on phones to leave room for the Archive button. #}
                            {{ sortHeader('Last message', sortLinks.lastMessage, 'hidden w-32 px-2 py-3 sm:table-cell sm:px-4') }}
                            {{ sortHeader('Messages (30 days)', sortLinks.messages, 'hidden w-32 px-2 py-3 text-right sm:px-4 md:table-cell') }}
                            {{ sortHeader('Status', sortLinks.status, 'w-28 px-2 py-3 sm:px-4') }}
                            {{ sortHeader('Archive recommended', sortLinks.archive, 'w-28 px-2 py-3 sm:w-36 sm:px-4') }}
                        {% endif %}
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200">
                    {% for channel in channels %}
                        <tr>
                            {% if archivedTab %}
                                {{ nameCell(channel) }}
                                {{ descriptionCell(channel) }}
                                <td class="px-2 py-3 whitespace-nowrap text-gray-600 sm:px-4">
                                    {% if channel.archivedAt %}
                                        {{ channel.archivedAt.toLocaleDateString('en-GB', {timeZone: 'Europe/London'}) }}
                                    {% else %}
                                        —
                                    {% endif %}
                                </td>
                            {% else %}
                                <td class="hidden py-3 pr-0 pl-2 sm:table-cell sm:pl-4">
                                    {% if channel.canArchive %}
                                        <input type="checkbox" name="ids" value="{{ channel.id }}" form="bulk-archive-form"
                                            data-bulk-select data-name="{{ channel.name }}"
                                            aria-label="Select #{{ channel.name }}"
                                            class="size-4 cursor-pointer accent-gray-900">
                                    {% endif %}
                                </td>
                                {{ nameCell(channel) }}
                                <td class="hidden px-2 py-3 text-right tabular-nums sm:px-4 md:table-cell">{{ channel.memberCount }}</td>
                                {{ descriptionCell(channel) }}
                                {# Other organisations in a Slack Connect channel. #}
                                <td class="hidden px-2 py-3 text-gray-600 sm:px-4 xl:table-cell">
                                    {% if channel.externalTeams | length %}
                                        <div class="line-clamp-2 break-words" title="{{ channel.externalTeams | join(', ') }}">{{ channel.externalTeams | join(', ') }}</div>
                                    {% endif %}
                                </td>
                                <td class="hidden px-2 py-3 whitespace-nowrap text-gray-600 sm:table-cell sm:px-4">
                                    {% if not channel.activity %}
                                        —
                                    {% elif channel.activity.lastMessageAt %}
                                        {{ channel.activity.lastMessageAt.toLocaleDateString('en-GB', {timeZone: 'Europe/London'}) }}
                                    {% else %}
                                        No messages
                                    {% endif %}
                                </td>
                                <td class="hidden px-2 py-3 text-right tabular-nums sm:px-4 md:table-cell">
                                    {% if not channel.activity %}
                                        —
                                    {% elif channel.activity.messagesLastMonth >= 100 %}
                                        100+
                                    {% else %}
                                        {{ channel.activity.messagesLastMonth }}
                                    {% endif %}
                                </td>
                                <td class="px-2 py-3 whitespace-nowrap sm:px-4">
                                    {# Nobody in it (not counting the bot): shown over every other status. #}
                                    {% if channel.memberCount == 0 %}
                                        <span class="rounded-full bg-red-100 px-2 py-0.5 text-xs text-red-800"
                                            title="This channel has no members">Empty</span>
                                    {% elif channel.inactive %}
                                        <span class="rounded-full bg-amber-100 px-2 py-0.5 text-xs text-amber-800">Inactive</span>
                                    {% elif channel.activity %}
                                        <span class="rounded-full bg-green-100 px-2 py-0.5 text-xs text-green-800">Active</span>
                                    {% elif not channel.isMember %}
                                        {# The bot can only read channels it's in, so their activity is unknown. #}
                                        <span class="rounded-full bg-gray-100 px-2 py-0.5 text-xs text-gray-700"
                                            title="The bot isn't in this channel, so it can't see the messages">Unknown</span>
                                    {% else %}
                                        <span class="text-xs text-gray-500">Not checked yet</span>
                                    {% endif %}
                                </td>
                                <td class="px-2 py-3 text-right sm:px-4">
                                    {# Only for quiet channels that are ours to archive. Asks to
                                       confirm first, in a modal (archive-dialog.js). #}
                                    {% if channel.canArchive %}
                                        <button type="button"
                                            data-archive-url="/channels/{{ channel.id }}/archive"
                                            data-archive-name="{{ channel.name }}"
                                            data-archive-reason="{{ archiveReason(channel) }}"
                                            class="inline-block cursor-pointer rounded-md border border-red-300 bg-white px-3 py-1.5 text-sm font-medium text-red-700 hover:bg-red-50 focus:outline-2 focus:outline-offset-2 focus:outline-gray-900">Archive<span class="sr-only"> #{{ channel.name }}</span></button>
                                    {% endif %}
                                </td>
                            {% endif %}
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="{{ 3 if archivedTab else 9 }}" class="px-4 py-6 text-center text-gray-500">
                                {% if q %}No {{ status }} channels match “{{ q }}”.{% else %}No {{ status }} channels.{% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        {% if pagination.total > 0 %}
            {% set linkClass = 'rounded-md border border-gray-300 bg-white px-3 py-1.5 font-medium hover:bg-gray-100 focus:outline-2 focus:outline-offset-2 focus:outline-gray-900' %}
            {% set disabledClass = 'rounded-md border border-gray-200 px-3 py-1.5 font-medium text-gray-400' %}
            <nav aria-label="Pagination" class="mt-4 flex flex-wrap items-center justify-between gap-2 text-sm">
                <p class="text-gray-600">
                    Showing {{ pagination.from }}–{{ pagination.to }} of {{ pagination.total }} channels
                </p>
                <div class="flex items-center gap-2">
                    {% if pagination.previousUrl %}
                        <a href="{{ pagination.previousUrl }}" rel="prev" class="{{ linkClass }}">Previous</a>
                    {% else %}
                        <span class="{{ disabledClass }}" aria-disabled="true">Previous</span>
                    {% endif %}
                    <span class="px-2 text-gray-600">Page {{ pagination.page }} of {{ pagination.totalPages }}</span>
                    {% if pagination.nextUrl %}
                        <a href="{{ pagination.nextUrl }}" rel="next" class="{{ linkClass }}">Next</a>
                    {% else %}
                        <span class="{{ disabledClass }}" aria-disabled="true">Next</span>
                    {% endif %}
                </div>
            </nav>
        {% endif %}
        </div>

        {# Asks to confirm archiving a channel. archive-dialog.js fills in the
           channel and opens it when an Archive button is clicked. Outside the
           results, as search.js replaces those. #}
        <dialog id="archive-dialog" aria-labelledby="archive-dialog-title"
            class="m-auto w-[calc(100%-2rem)] max-w-lg rounded-lg border border-gray-200 bg-white p-6 text-gray-900 shadow-lg backdrop:bg-gray-900/50">
            <h2 id="archive-dialog-title" class="text-lg font-semibold">Archive #<span data-archive-name></span>?</h2>
            <p class="mt-2 text-sm text-gray-600" data-archive-reason></p>
            <p class="mt-2 text-sm text-gray-600">
                Archiving removes it from people's channel list and stops new messages. Its history stays searchable, and it can be unarchived in Slack.
            </p>
            <div class="mt-6 flex items-center gap-3">
                <form method="post" data-archive-form>
                    <button class="cursor-pointer rounded-md bg-red-700 px-3 py-1.5 text-sm font-medium text-white hover:bg-red-800 focus:outline-2 focus:outline-offset-2 focus:outline-gray-900">
                        Archive channel
                    </button>
                </form>
                {# Closes the dialog without sending anything. Gets focus when it opens, so Enter doesn't archive by mistake. #}
                <form method="dialog">
                    <button autofocus class="cursor-pointer rounded-md border border-gray-300 bg-white px-3 py-1.5 text-sm font-medium hover:bg-gray-100 focus:outline-2 focus:outline-offset-2 focus:outline-gray-900">
                        Cancel
                    </button>
                </form>
            </div>
        </dialog>

        {# Asks to confirm archiving the ticked channels. bulk-archive.js fills
           in the list and opens it. #}
        <dialog id="bulk-archive-dialog" aria-labelledby="bulk-archive-dialog-title"
            class="m-auto w-[calc(100%-2rem)] max-w-lg rounded-lg border border-gray-200 bg-white p-6 text-gray-900 shadow-lg backdrop:bg-gray-900/50">
            <h2 id="bulk-archive-dialog-title" class="text-lg font-semibold">Archive <span data-bulk-dialog-count></span>?</h2>
            <ul class="mt-2 max-h-48 list-inside list-disc overflow-y-auto text-sm text-gray-600" data-bulk-dialog-list></ul>
            <p class="mt-2 text-sm text-gray-600">
                Archiving removes them from people's channel lists and stops new messages. Their history stays searchable, and they can be unarchived in Slack.
            </p>
            <p class="mt-2 text-sm text-gray-600">
                Each channel is checked with Slack first, and skipped if it no longer qualifies. This takes a few seconds per channel.
            </p>
            <div class="mt-6 flex items-center gap-3">
                {# Sends the selection bar's form, with the ticked checkboxes. #}
                <button form="bulk-archive-form" class="cursor-pointer rounded-md bg-red-700 px-3 py-1.5 text-sm font-medium text-white hover:bg-red-800 focus:outline-2 focus:outline-offset-2 focus:outline-gray-900">
                    Archive channels
                </button>
                {# Closes the dialog without sending anything. Gets focus when it opens, so Enter doesn't archive by mistake. #}
                <form method="dialog">
                    <button autofocus class="cursor-pointer rounded-md border border-gray-300 bg-white px-3 py-1.5 text-sm font-medium hover:bg-gray-100 focus:outline-2 focus:outline-offset-2 focus:outline-gray-900">
                        Cancel
                    </button>
                </form>
            </div>
        </dialog>
    {% endif %}

{% endblock %}

{% block scripts %}
    <script src="/search.js"></script>
    <script src="/archive-dialog.js"></script>
    <script src="/bulk-archive.js"></script>
{% endblock %}
