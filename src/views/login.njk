{% extends "layout.njk" %}
{% block title %}Sign in{% endblock %}
{% block content %}
    <div class="mx-auto max-w-sm rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
        <h2 class="text-lg font-semibold">Sign in</h2>
        <p class="mt-1 text-sm text-gray-600">Development only. Use any @dxw.com email address.</p>

        <form method="post" class="mt-6 space-y-4">
            <div>
                <label for="email" class="block text-sm font-medium">Email</label>
                <input id="email" name="email" type="email" required autocomplete="email"
                    class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-gray-900 focus:outline-2 focus:outline-gray-900">
            </div>
            <button class="w-full cursor-pointer rounded-md bg-gray-900 px-3 py-2 text-sm font-medium text-white hover:bg-gray-700 focus:outline-2 focus:outline-offset-2 focus:outline-gray-900">
                Sign in
            </button>
        </form>
    </div>
{% endblock %}
