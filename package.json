{
	"name": "slack-channel-panel",
	"version": "0.0.1",
	"description": "A dashboard to aid maintenance of dxw slack channels",
	"type": "module",
	"main": "index.js",
	"scripts": {
		"start": "node --env-file-if-exists=.env src/server.js",
		"dev": "nodemon --env-file=.env src/server.js",
		"test": "node --test",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write ."
	},
	"author": "dxw",
	"license": "MIT",
	"engines": {
		"node": "26.x"
	},
	"dependencies": {
		"express": "^5.3.0",
		"express-session": "^1.19.0",
		"memorystore": "^1.6.8",
		"nunjucks": "^3.2.4",
		"openid-client": "^6.8.9"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.14.0",
		"nodemon": "^3.1.14",
		"prettier": "^3.9.10"
	}
}
